# Copy this file to .env and fill in your own values.
# .env is ignored by git - never commit real keys.

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/openrec
# Separate database for pytest: the tests drop and recreate its tables
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/openrec_test

# LLM (Google AI Studio)
GEMINI_API_KEY=your-key-here
LLM_MODEL=gemini-model-name

# Himalayas API key (free, optional but recommended)
HIMALAYAS_API_KEY=

# Login tokens (any long random text)
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# Frontend addresses allowed to call the API (JSON list). Change it on the server.
CORS_ORIGINS=["http://localhost:5173"]

# App settings (lead threshold, fetch limit, retries...) are in the app_setting
# table, not here. Load the defaults with: python -m backend.db.seed_settings

# Copy this file to .env and fill in your own values.
# .env is ignored by git - never commit real keys.

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://openrec:openrec@localhost:5432/openrec
# Separate database for pytest: the tests drop and recreate its tables
TEST_DATABASE_URL=postgresql+psycopg://openrec:openrec@localhost:5432/openrec_test

# LLM (Google AI Studio)
GEMINI_API_KEY=your-key-here
LLM_MODEL=gemini-model-name

# Lead scoring: a job counts as suitable when fit_score >= this value
LEAD_THRESHOLD=60

# Job sources on/off
HIMALAYAS_ENABLED=true
REMOTIVE_ENABLED=true

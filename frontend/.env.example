# Copy this file to .env.local to change the settings (.env.local is not uploaded to Git).
# After a change, stop `npm run dev` (Ctrl+C) and start it again.

# true  = fake data from src/mockData.ts (default, no backend needed)
# false = the real FastAPI backend
VITE_USE_MOCK=true

# Address of the backend, used only when VITE_USE_MOCK=false
VITE_API_URL=http://localhost:8000